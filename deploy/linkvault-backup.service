[Unit]
Description=LinkVault SQLite online backup
Wants=network-online.target
After=local-fs.target network-online.target
OnFailure=linkvault-notify@%n.service

[Service]
Type=oneshot
User=linkvault-backup
Group=linkvault-backup
SupplementaryGroups=www-data
WorkingDirectory=/var/www/linkvault
Environment=LINKVAULT_BACKUP_DIR=/var/backups/linkvault
Environment=LINKVAULT_BACKUP_STATUS_DIR=/var/lib/linkvault-backup-status
Environment=LINKVAULT_BACKUP_REMOTE_REQUIRED=1
EnvironmentFile=-/etc/linkvault/linkvault.env
UMask=0027
TimeoutStartSec=30min
ExecStart=/usr/bin/php /var/www/linkvault/bin/backup.php
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/www/linkvault /var/lib/linkvault
ReadWritePaths=/var/backups/linkvault /var/lib/linkvault-backup-status

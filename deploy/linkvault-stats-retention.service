[Unit]
Description=LinkVault daily statistics retention
After=local-fs.target
OnFailure=linkvault-notify@%n.service

[Service]
Type=oneshot
User=www-data
WorkingDirectory=/var/www/linkvault
EnvironmentFile=-/etc/linkvault/linkvault.env
UMask=0077
TimeoutStartSec=10min
ExecStart=/usr/bin/php /var/www/linkvault/bin/retain-stats.php
NoNewPrivileges=true
PrivateTmp=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/www/linkvault
ReadWritePaths=/var/lib/linkvault /var/log/linkvault

[Unit]
Description=Migrate the LinkVault database
After=local-fs.target
Before=linkvault-preflight.service
Wants=linkvault-analytics-rollup-backfill.service

[Service]
Type=oneshot
User=www-data
WorkingDirectory=/var/www/linkvault
EnvironmentFile=/etc/linkvault/linkvault.env
UMask=0027
ExecStart=/usr/bin/php /var/www/linkvault/bin/migrate.php
ExecStartPost=/usr/bin/php /var/www/linkvault/bin/optimize-database.php

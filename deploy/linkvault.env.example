# Install as /etc/linkvault/linkvault.env with mode 0600 and replace every placeholder and example endpoint.
LINKVAULT_ENV=production
LINKVAULT_ADMIN_PASSWORD=REPLACE_ME
LINKVAULT_BASE_URL=https://s.example.com
# Required before Chrome Web Store publishing. Displayed on /browser-extension-privacy.
LINKVAULT_BROWSER_EXTENSION_PRIVACY_CONTACT=privacy@example.com
LINKVAULT_RELEASE_VERSION=V2.0.0
LINKVAULT_BUILD_TIME=2026-08-05T00:00:00Z
LINKVAULT_RELEASE_CHANGELOG=Added release center|Improved endpoint monitoring
LINKVAULT_RELEASE_ROLLBACK_VERSION=0.9.0

# Stable public redirect used by external synthetic probes. Seed it after migration.
LINKVAULT_CANARY_ENABLED=1
LINKVAULT_CANARY_SLUG=monitor-canary
LINKVAULT_CANARY_TARGET_URL=https://s.example.com/
LINKVAULT_SYNTHETIC_STATUS_PATH=/var/lib/linkvault/.synthetic-monitor-state.json
LINKVAULT_SYNTHETIC_STATUS_MAX_AGE_SECONDS=900

# Optional legacy create-only API token. Managed tokens can be created after login.
LINKVAULT_API_TOKEN=
LINKVAULT_IDEMPOTENCY_RETENTION_SECONDS=86400
LINKVAULT_API_RATE_LIMIT_REQUESTS=60
LINKVAULT_API_RATE_LIMIT_WINDOW_SECONDS=60
LINKVAULT_API_TOKEN_ROTATION_OVERLAP_SECONDS=900
LINKVAULT_API_TOKEN_ROTATION_MAX_OVERLAP_SECONDS=86400
LINKVAULT_API_TOKEN_USAGE_RETENTION_DAYS=90
LINKVAULT_API_TOKEN_FAILED_USAGE_MAX_RECORDS=1000

# Public per-link password verification. Keep these separate from administrator login limits.
LINKVAULT_UNLOCK_MAX_ATTEMPTS=5
LINKVAULT_UNLOCK_ATTEMPT_WINDOW_SECONDS=900
LINKVAULT_UNLOCK_LOCK_DURATION_SECONDS=900
LINKVAULT_UNLOCK_GRANT_TTL_SECONDS=120

# Optional TOTP encryption key. Generate at least 32 random characters before enabling TOTP.
LINKVAULT_SECURITY_KEY=

# Keep empty when Nginx is directly exposed to clients. Otherwise list only the
# exact direct IPs of upstream proxies, separated by commas.
LINKVAULT_TRUSTED_PROXIES=

LINKVAULT_DATABASE_PATH=/var/lib/linkvault/linkvault.sqlite
LINKVAULT_LOG_PATH=/var/log/linkvault/application.log
# Per-worker SQLite page cache. Start at 32 MiB and budget for pm.max_children workers.
LINKVAULT_SQLITE_CACHE_SIZE_KIB=32768
LINKVAULT_SQLITE_BUSY_TIMEOUT_MS=5000
LINKVAULT_SQLITE_SLOW_QUERY_MS=250
LINKVAULT_REDIRECT_BUSY_TIMEOUT_MS=250
LINKVAULT_REDIRECT_RETRY_ATTEMPTS=2
LINKVAULT_BACKUP_DIR=/var/backups/linkvault
LINKVAULT_BACKUP_STATUS_DIR=/var/lib/linkvault-backup-status
LINKVAULT_BACKUP_RETENTION_DAYS=14
LINKVAULT_BACKUP_COMMAND_TIMEOUT_SECONDS=900
LINKVAULT_SQLITE3_BIN=/usr/bin/sqlite3
LINKVAULT_BACKUP_MAX_AGE_SECONDS=28800
LINKVAULT_BACKUP_INTEGRITY_CHECK_INTERVAL_SECONDS=300
LINKVAULT_BACKUP_REMOTE_REQUIRED=1
LINKVAULT_AGE_BIN=/usr/bin/age
LINKVAULT_BACKUP_AGE_RECIPIENT=age1REPLACE_ME
LINKVAULT_RCLONE_BIN=/usr/bin/rclone
LINKVAULT_BACKUP_RCLONE_REMOTE=object-storage:linkvault-production
LINKVAULT_RESTORE_DRILL_DIR=/var/lib/linkvault-restore-drill
LINKVAULT_RESTORE_DRILL_SOURCE=remote
# The systemd restore/preflight units set these to private LoadCredential paths.
# Set explicit readable paths only when running the drill outside those units.
# LINKVAULT_RESTORE_AGE_IDENTITY=/secure/path/restore-age-identity
# LINKVAULT_RESTORE_RCLONE_CONFIG=/secure/path/restore-rclone.conf
LINKVAULT_RESTORE_DRILL_MAX_AGE_SECONDS=691200
LINKVAULT_STATUS_ANOMALY_WINDOW_SECONDS=86400
LINKVAULT_METRICS_TOKEN=REPLACE_ME
LINKVAULT_AUDIT_RETENTION_DAYS=180
LINKVAULT_MAINTENANCE_BATCH_SIZE=500
LINKVAULT_API_TOKEN_RETENTION_DAYS=180
LINKVAULT_DOMAIN_RETIREMENT_BATCH_SIZE=200
LINKVAULT_DOMAIN_RETIREMENT_MAX_BATCHES=10

# Daily link and backup maintenance summary. Webhooks require public HTTPS on port 443 and never follow redirects.
# Bearer tokens may contain only RFC 6750 b64token characters. Leave the URL empty to disable delivery.
LINKVAULT_MAINTENANCE_WEBHOOK_URL=
LINKVAULT_MAINTENANCE_WEBHOOK_BEARER_TOKEN=
LINKVAULT_MAINTENANCE_EXPIRING_DAYS=7
LINKVAULT_MAINTENANCE_STALE_DAYS=90
LINKVAULT_MAINTENANCE_QUOTA_PERCENT=80
LINKVAULT_LIFECYCLE_WEBHOOK_URL=
LINKVAULT_LIFECYCLE_WEBHOOK_BEARER_TOKEN=
LINKVAULT_LIFECYCLE_WEBHOOK_SIGNING_SECRET=
LINKVAULT_LIFECYCLE_WEBHOOK_RETENTION_DAYS=180
LINKVAULT_LIFECYCLE_WEBHOOK_ATTEMPT_RETENTION_DAYS=90

# Cumulative clicks are retained on links. Per-day rows use archive or delete.
LINKVAULT_DAILY_STATS_RETENTION_DAYS=365
LINKVAULT_DAILY_STATS_RETENTION_MODE=archive
LINKVAULT_DAILY_STATS_ARCHIVE_RETENTION_DAYS=1095

# SQLite stores analytics aggregates and the transactional ingest position.
LINKVAULT_ANALYTICS_LOG_PATH=/var/log/linkvault/nginx-linkvault-analytics.log
# Health marker consumed by the status center; it is not the ingest position.
LINKVAULT_ANALYTICS_STATE_PATH=/var/lib/linkvault/.analytics-ingest-state.json
LINKVAULT_ANALYTICS_STATUS_MAX_AGE_SECONDS=900
LINKVAULT_ANALYTICS_RAW_LOG_RETENTION_DAYS=30
LINKVAULT_ANALYTICS_HOURLY_RETENTION_DAYS=90
LINKVAULT_ANALYTICS_RETENTION_DAYS=365
LINKVAULT_ANALYTICS_BATCH_MAX_LINES=100000
LINKVAULT_ANALYTICS_MATERIALIZE_MAX_ROWS=250000
LINKVAULT_ANALYTICS_REPORT_CACHE_SECONDS=60
LINKVAULT_ANALYTICS_REPORT_CACHE_DIR=/var/lib/linkvault/analytics-report-cache
LINKVAULT_ANALYTICS_EXPORT_DIR=/var/lib/linkvault/analytics-exports
LINKVAULT_ANALYTICS_EXPORT_RETENTION_HOURS=24
LINKVAULT_ANALYTICS_EXPORT_LEASE_SECONDS=900
LINKVAULT_ANALYTICS_EXPORT_WORKER_BATCH_SIZE=5
LINKVAULT_ANALYTICS_EXPORT_MAX_ROWS=500000
LINKVAULT_ANALYTICS_ANOMALY_SPIKE_FACTOR=3
LINKVAULT_ANALYTICS_ANOMALY_MIN_REQUESTS=20
LINKVAULT_ANALYTICS_ANOMALY_ZERO_HOURS=6
LINKVAULT_ANALYTICS_ANOMALY_BOT_RATIO=0.8
LINKVAULT_ANALYTICS_ANOMALY_COOLDOWN_SECONDS=21600

# Weekly (completed Monday-Sunday) and monthly (completed calendar month) management summaries.
# Configure either or both delivery channels. Webhooks follow the same public HTTPS/443, no-redirect policy.
# Email recipients are comma-separated and use the server's configured PHP mail transport.
LINKVAULT_BUSINESS_SUMMARY_WEEKLY_WEBHOOK_URL=
LINKVAULT_BUSINESS_SUMMARY_WEEKLY_WEBHOOK_BEARER_TOKEN=
LINKVAULT_BUSINESS_SUMMARY_WEEKLY_EMAIL_TO=
LINKVAULT_BUSINESS_SUMMARY_MONTHLY_WEBHOOK_URL=
LINKVAULT_BUSINESS_SUMMARY_MONTHLY_WEBHOOK_BEARER_TOKEN=
LINKVAULT_BUSINESS_SUMMARY_MONTHLY_EMAIL_TO=
LINKVAULT_BUSINESS_SUMMARY_EMAIL_FROM=

# Periodic target checks run outside request handling. Enabling requires PHP ext-curl.
LINKVAULT_TARGET_HEALTH_ENABLED=1
LINKVAULT_TARGET_HEALTH_INTERVAL_SECONDS=900
LINKVAULT_TARGET_HEALTH_BATCH_SIZE=50
LINKVAULT_TARGET_HEALTH_CONNECT_TIMEOUT_MS=3000
LINKVAULT_TARGET_HEALTH_HOP_TIMEOUT_MS=8000
LINKVAULT_TARGET_HEALTH_TOTAL_TIMEOUT_MS=30000
LINKVAULT_TARGET_HEALTH_MAX_REDIRECTS=5
LINKVAULT_TARGET_HEALTH_HEADER_MAX_BYTES=32768
LINKVAULT_TARGET_HEALTH_BODY_MAX_BYTES=65536
LINKVAULT_TARGET_HEALTH_ALLOWED_PORTS=80,443
LINKVAULT_TARGET_HEALTH_STATUS_PATH=/var/lib/linkvault/.target-health-state.json

# Used by linkvault-notify@.service. The same public HTTPS/443 and no-redirect policy applies.
# Keep credentials only in this mode-0600 file.
LINKVAULT_ALERT_WEBHOOK_URL=https://alerts.example.net/REPLACE_ME
LINKVAULT_ALERT_BEARER_TOKEN=REPLACE_ME

# Readiness fails before SQLite reaches this amount of free filesystem space.
LINKVAULT_HEALTH_MIN_FREE_BYTES=134217728
LINKVAULT_HEALTH_BUSY_TIMEOUT_MS=100

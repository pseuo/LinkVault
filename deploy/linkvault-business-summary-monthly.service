[Unit]
Description=Send LinkVault monthly business summary
Wants=network-online.target
After=local-fs.target network-online.target linkvault-migrate.service
OnFailure=linkvault-notify@%n.service

[Service]
Type=oneshot
User=www-data
WorkingDirectory=/var/www/linkvault
EnvironmentFile=-/etc/linkvault/linkvault.env
UMask=0077
TimeoutStartSec=2min
ExecStart=/usr/bin/php /var/www/linkvault/bin/send-business-summary.php monthly
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/www/linkvault
ReadWritePaths=/var/lib/linkvault /var/log/linkvault

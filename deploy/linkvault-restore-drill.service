[Unit]
Description=LinkVault isolated backup restore drill
Wants=network-online.target
After=local-fs.target network-online.target
OnFailure=linkvault-notify@%n.service

[Service]
Type=oneshot
User=www-data
WorkingDirectory=/var/www/linkvault
Environment=LINKVAULT_BACKUP_DIR=/var/backups/linkvault
Environment=LINKVAULT_RESTORE_DRILL_DIR=/var/lib/linkvault-restore-drill
EnvironmentFile=-/etc/linkvault/linkvault.env
LoadCredential=restore-age-identity:/etc/linkvault/restore-age-identity
LoadCredential=restore-rclone-config:/etc/linkvault/restore-rclone.conf
Environment=LINKVAULT_RESTORE_AGE_IDENTITY=%d/restore-age-identity
Environment=LINKVAULT_RESTORE_RCLONE_CONFIG=%d/restore-rclone-config
UMask=0077
TimeoutStartSec=30min
ExecStart=/usr/bin/php /var/www/linkvault/bin/restore-drill.php
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/www/linkvault
ReadWritePaths=/var/backups/linkvault /var/lib/linkvault-restore-drill

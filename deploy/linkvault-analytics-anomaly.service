[Unit]
Description=Detect LinkVault analytics anomalies
After=network-online.target linkvault-migrate.service
Wants=network-online.target
OnFailure=linkvault-notify@%n.service

[Service]
Type=oneshot
User=www-data
WorkingDirectory=/var/www/linkvault
EnvironmentFile=-/etc/linkvault/linkvault.env
UMask=0077
TimeoutStartSec=2min
ExecStart=/usr/bin/php /var/www/linkvault/bin/check-analytics-anomalies.php
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/www/linkvault
ReadWritePaths=/var/lib/linkvault /var/log/linkvault

[Unit]
Description=Aggregate LinkVault visitor analytics
After=network.target linkvault-migrate.service
OnFailure=linkvault-notify@%n.service

[Service]
Type=oneshot
User=www-data
Group=www-data
SupplementaryGroups=adm
EnvironmentFile=/etc/linkvault/linkvault.env
WorkingDirectory=/var/www/linkvault
UMask=0077
TimeoutStartSec=10min
ExecStart=/usr/bin/php /var/www/linkvault/bin/aggregate-analytics.php
NoNewPrivileges=true
PrivateTmp=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/www/linkvault
ReadWritePaths=/var/lib/linkvault /var/log/linkvault
